DATABASE_URL=postgresql://user:password@host:5432/dbname
WAYFORPAY_SECRET_KEY=replace-me
PORT=3000

# Conversation webhook (второй слайс, живёт в этом же сервисе — см. README).
# TELEGRAM_BOT_TOKEN: на время тестов — токен ОТДЕЛЬНОГО тестового бота
# (создать за 30 секунд через @BotFather, /newbot), не токен живой Тали.
TELEGRAM_BOT_TOKEN=replace-me
# Можно оставить пустым, пока тестируем через curl.
TELEGRAM_WEBHOOK_SECRET=

# Онбординг / расчёт карты (шаг 4).
# THD_API_KEY: ключ к api.totalhumandesign.com. Заголовок "Authorization"
# подтверждён (сверено с credential "THD API" в n8n, 04.08.2026). Значение
# сюда — БЕЗ слова "Bearer " спереди, код добавляет его сам в chartCalc.js.
THD_API_KEY=replace-me
# Тот же ключ Claude, что используется в основном боте — для генерации
# текста расшифровки карты (эквивалент ноды "HTTP Claude" в n8n).
ANTHROPIC_API_KEY=replace-me

# Видео-кружок в самом начале онбординга ("Видео приветствие" в n8n).
# ВАЖНО: file_id в Telegram привязан к конкретному боту — file_id из живого
# бота Тали НЕ сработает через тестового бота. Для тестов получить свой
# file_id (см. инструкцию в ПРОГРЕСС_И_ИНСТРУКЦИИ.md), для прод — взять
# значение из ноды "Видео приветствие" в n8n при переключении.
WELCOME_VIDEO_NOTE_FILE_ID=replace-me

# English website (/web/... routes), added 08.11.2026.
# Addresses allowed to call /web from a browser, comma-separated.
# Local preview of the site is http://localhost:3000; add the Netlify address at stage 4.
WEB_ALLOWED_ORIGINS=http://localhost:3000
# Safety fuse: at most this many NEW charts (THD calls) per 24 hours.
WEB_DAILY_THD_LIMIT=300
# Per visitor: new charts per hour, and all requests per hour.
WEB_NEW_CHARTS_PER_IP_PER_HOUR=8
WEB_REQUESTS_PER_IP_PER_HOUR=60
# City suggestions (/web/places): requests per visitor per hour.
WEB_PLACES_PER_IP_PER_HOUR=300
